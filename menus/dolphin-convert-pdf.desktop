[Desktop Entry]
Type=Service
MimeType=application/pdf;
Actions=png;jpg;txt;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Convert to…
X-KDE-Submenu[uk]=Конвертувати в…
X-KDE-Submenu[de]=Umwandeln in…
X-KDE-Submenu[es]=Convertir a…
X-KDE-Submenu[fr]=Convertir en…
X-KDE-Submenu[pl]=Konwertuj na…
X-KDE-Submenu[nl]=Converteren naar…
X-KDE-Submenu[ca]=Converteix a…

[Desktop Action png]
Name=PNG
Exec=dolphin-convert pdf png %F

[Desktop Action jpg]
Name=JPG
Exec=dolphin-convert pdf jpg %F

[Desktop Action txt]
Name=TXT
Exec=dolphin-convert pdf txt %F
