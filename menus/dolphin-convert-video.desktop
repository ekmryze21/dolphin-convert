[Desktop Entry]
Type=Service
MimeType=video/*;
Actions=_SEPARATOR_;h264;vp9;gif;mp3;_SEPARATOR_;copy-mp4;10mb;_SEPARATOR_;ask;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Convert to…
X-KDE-Submenu[uk]=Конвертувати в…
X-KDE-Submenu[de]=Umwandeln in…
X-KDE-Submenu[es]=Convertir a…
X-KDE-Submenu[fr]=Convertir en…
X-KDE-Submenu[pl]=Konwertuj na…
X-KDE-Submenu[nl]=Converteren naar…
X-KDE-Submenu[ca]=Converteix a…

# Dolphin takes the submenu icon from the first entry and hides a leading separator
[Desktop Action _SEPARATOR_]
Icon=dolphin-convert-outline

[Desktop Action h264]
Name=MP4
Exec=dolphin-convert video h264 %F

[Desktop Action vp9]
Name=WebM
Exec=dolphin-convert video vp9 %F

[Desktop Action gif]
Name=GIF
Exec=dolphin-convert video gif %F

[Desktop Action mp3]
Name=MP3 (audio only)
Name[uk]=MP3 (лише звук)
Name[de]=MP3 (nur Ton)
Name[es]=MP3 (solo audio)
Name[fr]=MP3 (audio seul)
Name[pl]=MP3 (tylko dźwięk)
Name[nl]=MP3 (alleen audio)
Name[ca]=MP3 (només àudio)
Exec=dolphin-convert video mp3 %F

[Desktop Action copy-mp4]
Name=MP4 (no re-encoding)
Name[uk]=MP4 (без перекодування)
Name[de]=MP4 (ohne Neukodierung)
Name[es]=MP4 (sin recodificar)
Name[fr]=MP4 (sans réencodage)
Name[pl]=MP4 (bez rekodowania)
Name[nl]=MP4 (zonder hercodering)
Name[ca]=MP4 (sense recodificar)
Exec=dolphin-convert video copy-mp4 %F

[Desktop Action 10mb]
Name=MP4, up to 10 MB
Name[uk]=MP4, до 10 МБ
Name[de]=MP4, bis 10 MB
Name[es]=MP4, hasta 10 MB
Name[fr]=MP4, jusqu’à 10 Mo
Name[pl]=MP4, do 10 MB
Name[nl]=MP4, tot 10 MB
Name[ca]=MP4, fins a 10 MB
Exec=dolphin-convert video 10mb %F

[Desktop Action ask]
Name=More options…
Name[uk]=Більше параметрів…
Name[de]=Weitere Optionen…
Name[es]=Más opciones…
Name[fr]=Plus d’options…
Name[pl]=Więcej opcji…
Name[nl]=Meer opties…
Name[ca]=Més opcions…
Exec=dolphin-convert video ask %F
