[Desktop Entry]
Type=Service
MimeType=audio/*;
Actions=mp3;m4a;opus;ogg;flac;wav;_SEPARATOR_;ask;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Convert to…
X-KDE-Submenu[uk]=Конвертувати в…
X-KDE-Submenu[de]=Umwandeln in…
X-KDE-Submenu[es]=Convertir a…
X-KDE-Submenu[fr]=Convertir en…
X-KDE-Submenu[pl]=Konwertuj na…
X-KDE-Submenu[nl]=Converteren naar…
X-KDE-Submenu[ca]=Converteix a…

[Desktop Action mp3]
Name=MP3
Exec=dolphin-convert audio mp3 %F

[Desktop Action m4a]
Name=M4A
Exec=dolphin-convert audio m4a %F

[Desktop Action opus]
Name=Opus
Exec=dolphin-convert audio opus %F

[Desktop Action ogg]
Name=OGG
Exec=dolphin-convert audio ogg %F

[Desktop Action flac]
Name=FLAC
Exec=dolphin-convert audio flac %F

[Desktop Action wav]
Name=WAV
Exec=dolphin-convert audio wav %F

[Desktop Action ask]
Name=More options…
Name[uk]=Більше параметрів…
Name[de]=Weitere Optionen…
Name[es]=Más opciones…
Name[fr]=Plus d’options…
Name[pl]=Więcej opcji…
Name[nl]=Meer opties…
Name[ca]=Més opcions…
Exec=dolphin-convert audio ask %F
