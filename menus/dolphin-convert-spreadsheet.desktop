[Desktop Entry]
Type=Service
MimeType=application/vnd.oasis.opendocument.spreadsheet;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel;text/csv;
Actions=_SEPARATOR_;pdf;xlsx;ods;csv;
X-KDE-Priority=TopLevel
X-KDE-Submenu=Convert to…
X-KDE-Submenu[uk]=Конвертувати в…
X-KDE-Submenu[de]=Umwandeln in…
X-KDE-Submenu[es]=Convertir a…
X-KDE-Submenu[fr]=Convertir en…
X-KDE-Submenu[pl]=Konwertuj na…
X-KDE-Submenu[nl]=Converteren naar…
X-KDE-Submenu[ca]=Converteix a…

# Dolphin takes the submenu icon from the first entry and hides a leading separator
[Desktop Action _SEPARATOR_]
Icon=dolphin-convert-outline

[Desktop Action pdf]
Name=PDF
Exec=dolphin-convert office pdf %F

[Desktop Action xlsx]
Name=XLSX
Exec=dolphin-convert office xlsx %F

[Desktop Action ods]
Name=ODS
Exec=dolphin-convert office ods %F

[Desktop Action csv]
Name=CSV
Exec=dolphin-convert office csv %F
