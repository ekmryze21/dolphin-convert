#!/bin/bash
# Dolphin context-menu converter: dolphin-convert KIND FORMAT|ask FILE...
trap '' PIPE
export LC_NUMERIC=C

declare -A tr
locale=${LANGUAGE%%:*}
locale=${locale:-${LC_ALL:-${LC_MESSAGES:-$LANG}}}
locale=${locale%%[_.@]*}
share=${0%/*}/../share/dolphin-convert  # works in ~/.local and in /usr
lang_file=$share/lang/$locale.sh
[[ $locale =~ ^[a-z]{2,3}$ && -r $lang_file ]] && . "$lang_file"
t() { printf '%s' "${tr[$1]:-$1}"; }

title=$(t Convert)
ui_app=$share/ui.py
usage() { echo "Usage: dolphin-convert video|audio|image|pdf|office|ebook FORMAT|ask FILE..." >&2; exit 2; }
die() { kdialog --icon dolphin-convert --title "$title" --error "$(t "$1")${2:+: $2}"; exit 1; }
no_ui() { die "Not installed" "python3-gobject, libadwaita"; }
need() { local c; for c; do command -v "$c" >/dev/null || die "Not installed" "$c"; done; }
[[ $1 == --version ]] && { cat -- "$share/VERSION"; exit; }
(( $# >= 3 )) || usage
kind=$1 format=$2
shift 2

declare -A label=(
  [h264]="MP4 (H.264)" [h265]="MP4 (H.265)" [vp9]="WebM (VP9)" [av1]="MP4 (AV1)" [gif]=GIF
  [copy-mp4]="MP4 ($(t "no re-encoding"))" [copy-mkv]="MKV ($(t "no re-encoding"))"
  [mp3]=MP3 [m4a]="M4A (AAC)" [opus]=Opus [ogg]="OGG (Vorbis)" [flac]=FLAC [wav]=WAV
  [jpg]=JPG [png]=PNG [webp]=WebP [avif]=AVIF [jxl]=JXL [tiff]=TIFF [bmp]=BMP [ico]=ICO
  [epub]=EPUB [mobi]=MOBI [azw3]=AZW3 [pdf]=PDF [pdf-one]="PDF ($(t "one file"))" [txt]=TXT
)
actions=()  # menu-only, not offered in the form
case $kind in
  video) formats=(h264 h265 av1 vp9 gif mp3 copy-mp4 copy-mkv); label[mp3]="MP3 ($(t "audio only"))"
    actions=(mute rotate-left rotate-right srt) ;;
  audio) formats=(mp3 m4a opus ogg flac wav) ;;
  image) formats=(jpg png webp avif jxl tiff gif bmp ico pdf pdf-one) ;;
  pdf) formats=(png jpg txt); actions=(merge split compress ocr) ;;
  office) formats=(pdf docx odt xlsx ods csv pptx odp) ;;
  ebook) formats=(epub mobi azw3 pdf txt) ;;
  *) usage ;;
esac

q=1 height=0 gpu=FALSE strip=FALSE start= end= size=
qualities=("$(t High)" "$(t Normal)" "$(t "Small file")")
original=$(t Original)

# combo SELECTED ITEM...: ui.py combo box values with one preselected
combo() {
  local selected=$1 item out=
  shift
  for item; do
    [[ $item == "$selected" ]] && item="^$item"
    out+="!$item"
  done
  printf '%s' "${out:1}"
}

ask() {
  local config=${XDG_CONFIG_HOME:-$HOME/.config}/dolphin-convert
  local f_fmt f_q f_h f_gpu f_strip f_start f_end f_size answer i labels=() fields=()
  local saved_fmt saved_q saved_h saved_gpu saved_strip
  [[ -r $config/$kind ]] && IFS='|' read -r saved_fmt saved_q saved_h saved_gpu saved_strip <"$config/$kind"
  [[ $saved_q == [012] ]] || saved_q=1
  [[ $saved_h == @(1080|720|480) ]] || saved_h=$original
  [[ $saved_gpu == TRUE ]] || saved_gpu=FALSE
  [[ $saved_strip == TRUE ]] || saved_strip=FALSE
  for i in "${formats[@]}"; do labels+=("${label[$i]}"); done

  fields+=("$(t Format)" CB "$(combo "${label[${saved_fmt:-${formats[0]}}]}" "${labels[@]}")")
  [[ $kind == pdf ]] || fields+=("$(t Quality)" CB "$(combo "${qualities[saved_q]}" "${qualities[@]}")")
  [[ $kind == @(video|image) ]] && fields+=("$(t "Max height")" CB "$(combo "$saved_h" "$original" 1080 720 480)")
  [[ $kind == @(video|audio) ]] && fields+=("$(t Start) (0:15)" TEXT "" "$(t End) (1:30)" TEXT "")
  [[ $kind == video ]] && fields+=("$(t "Target size, MB")" TEXT "" "$(t "Use GPU")" CHK "$saved_gpu")
  [[ $kind == @(video|audio|image) ]] && fields+=("$(t "Remove metadata")" CHK "$saved_strip")

  answer=$("$ui_app" form "$title" "$subtitle" "$title" "${fields[@]}") || no_ui
  [[ $answer ]] || exit 0
  case $kind in
    video) IFS='|' read -r f_fmt f_q f_h f_start f_end f_size f_gpu f_strip _ <<<"$answer" ;;
    audio) IFS='|' read -r f_fmt f_q f_start f_end f_strip _ <<<"$answer" ;;
    image) IFS='|' read -r f_fmt f_q f_h f_strip _ <<<"$answer" ;;
    pdf) IFS='|' read -r f_fmt _ <<<"$answer" ;;
  esac

  for i in "${formats[@]}"; do [[ ${label[$i]} == "$f_fmt" ]] && format=$i; done
  for i in 0 1 2; do [[ ${qualities[i]} == "$f_q" ]] && q=$i; done
  [[ $f_h =~ ^[0-9]+$ ]] && height=$f_h
  [[ $f_gpu == TRUE ]] && gpu=TRUE
  [[ $f_strip == TRUE ]] && strip=TRUE
  start=$f_start end=$f_end size=$f_size
  mkdir -p "$config" && printf '%s\n' "$format|$q|$height|$gpu|$strip" >"$config/$kind"
}

# Print [[H:]M:]S[.frac] as microseconds
to_us() {
  [[ $1 =~ ^(([0-9]{1,3}):)?(([0-9]{1,4}):)?([0-9]{1,6})(\.([0-9]{1,6}))?$ ]] || return 1
  local h=${BASH_REMATCH[2]:-0} m=${BASH_REMATCH[4]:-0} s=${BASH_REMATCH[5]} frac=${BASH_REMATCH[7]}000000
  # A single colon means M:S, which the regex captures in the hours group
  [[ ${BASH_REMATCH[4]} ]] || { m=$h; h=0; }
  echo $(( ((10#$h * 60 + 10#$m) * 60 + 10#$s) * 1000000 + 10#${frac:0:6} ))
}

subtitle=${1##*/}
subtitle=${subtitle//$'\n'/_}
(( $# > 1 )) && subtitle="$(t "Selected files"): $#"
if [[ $format == ask ]]; then
  ask "$@"
elif [[ $format == 10mb && $kind == video ]]; then
  format=h264 height=720 size=10
fi
[[ " ${formats[*]} ${actions[*]} " == *" $format "* ]] || usage

case $kind in
  video|audio) need ffmpeg ffprobe ;;
  image) need magick; [[ $format == avif ]] && need ffmpeg; [[ $format == pdf-one ]] && need pdfunite ;;
  pdf)
    case $format in
      txt) need pdftotext ;;
      merge) need pdfunite; (( $# > 1 )) || die "Select several files" ;;
      split) need pdfseparate ;;
      compress) need gs ;;
      ocr) need ocrmypdf tesseract ;;
      *) need pdftoppm ;;
    esac ;;
  office) need soffice ;;
  ebook) need ebook-convert ;;
esac

# Some distributions ship ffmpeg without the patented encoders
declare -A encoder=([h264]=libx264 [h265]=libx265 [av1]=libsvtav1 [vp9]=libvpx-vp9 [mp3]=libmp3lame [opus]=libopus
  [ogg]=libvorbis [avif]=libaom-av1 [rotate-left]=libx264 [rotate-right]=libx264)
if [[ $kind == @(video|audio|image) && ${encoder[$format]} ]]; then
  [[ $(ffmpeg -hide_banner -encoders 2>/dev/null) == *" ${encoder[$format]} "* ]] || die "ffmpeg was built without an encoder" "${encoder[$format]}"
fi

start_us=0 end_us=0
if [[ $start ]]; then start_us=$(to_us "$start") || die "Invalid time"; fi
if [[ $end ]]; then
  end_us=$(to_us "$end") || die "Invalid time"
  (( end_us > start_us )) || die "Invalid time"
fi
if [[ $size ]]; then
  [[ $size =~ ^[1-9][0-9]{0,5}$ ]] || die "Invalid size"
  [[ $format == @(h264|h265|vp9) ]] || die "Target size works only with H.264, H.265 and VP9"
fi

case $format in
  h264|h265|av1|copy-mp4|rotate-*) ext=mp4 ;;
  vp9) ext=webm ;;
  copy-mkv) ext=mkv ;;
  pdf-one|merge|split|compress|ocr) ext=pdf ;;
  *) ext=$format ;;
esac
pages= merge=
[[ $format == pdf-one ]] && merge=1 format=pdf
[[ $format == merge ]] && merge=1
[[ $kind == pdf && $format == @(png|jpg|split) ]] && pages=1

tmp=$(mktemp -d) || exit 1
job= part=
stop_job() { kill -KILL -- "-$job" "$job"; wait "$job"; }
trap '[[ $job ]] && stop_job 2>/dev/null; rm -rf "$tmp"; [[ $part ]] && rm -rf "$part"' EXIT
trap 'exit 1' INT TERM

exec 3> >("$ui_app" progress "$(t Converting)" "$subtitle" "$(t Cancel)" >/dev/null 2>&1 || : >"$tmp/no_ui")
ui=$!

total=$# index=0 done_n=0 failed=()
pass_base=0 pass_span=100 clip_us=0 last_shown=

show_progress() {
  local us=0 pct shown
  if (( clip_us > 0 )); then
    us=$(sed -n 's/^out_time_us=\([0-9]\{1,\}\)$/\1/p' "$tmp/progress" | tail -n1)
  fi
  pct=$(( clip_us > 0 ? ${us:-0} * pass_span / clip_us + pass_base : 0 ))
  (( pct > 99 )) && pct=99
  shown="$((index + 1)) $(t of) $total: ${name//$'\n'/_}"
  (( clip_us > 0 )) && shown+=" ($pct%)"
  pct=$(( (index * 100 + pct) / total ))
  [[ $shown == "$last_shown" ]] && return
  last_shown=$shown
  printf '%s\n# %s\n' "$pct" "$shown" >&3
}

# Run a command, updating progress; its stdout goes to $sink if set
run() {
  local rc
  : >"$tmp/progress"
  setsid "$@" </dev/null >"${sink:-/dev/null}" 2>"$tmp/log" 3>&- &
  job=$!
  while kill -0 "$job" 2>/dev/null; do
    kill -0 "$ui" 2>/dev/null || { [[ -e $tmp/no_ui ]] && no_ui; notify-send -i dolphin-convert -a dolphin-convert "$title" "$(t Canceled). $(t Done): $done_n"; exit 1; }
    show_progress 2>/dev/null
    sleep 0.2
  done
  wait "$job"
  rc=$?
  job=
  return $rc
}

ffmpeg_run() { run ffmpeg -nostdin -y -v error -progress "$tmp/progress" "$@"; }

probe() { ffprobe -v error -show_entries "$1" -of csv=p=0 -i "$f" 2>/dev/null | head -n1; }

# Find the encoder family that really works on this machine
hw=
if [[ $gpu == TRUE && -z $size && $format == @(h264|h265) ]]; then
  codec=${format/h265/hevc}
  test_src=(-v error -f lavfi -i color=s=640x360:d=0.1)
  if ffmpeg "${test_src[@]}" -c:v "${codec}_nvenc" -f null - 2>/dev/null; then
    hw=nvenc
  else
    for node in /dev/dri/renderD*; do
      ffmpeg -vaapi_device "$node" "${test_src[@]}" -vf format=nv12,hwupload -c:v "${codec}_vaapi" -f null - 2>/dev/null &&
        { hw=vaapi; break; }
    done
  fi
fi

# fit_size: two-pass encode under $size MB
fit_size() {
  local limit=$((size * 1000000)) total_kbps audio=96 video source_kbps codec_args pass_args p try actual
  (( clip_us > 0 )) || { err="Unknown duration"; return 1; }
  total_kbps=$(( limit * 8 * 96 / 100 * 1000 / clip_us ))
  (( total_kbps < 400 )) && audio=48
  [[ $(ffprobe -v error -select_streams a -show_entries stream=index -of csv=p=0 -i "$f") ]] || audio=0
  video=$((total_kbps - audio))
  (( video >= 40 )) || { err="File is too long for this size"; return 1; }
  source_kbps=$(( $(stat -Lc %s -- "$f") * 8 * 1000 / duration_us ))
  (( source_kbps < 40 )) && source_kbps=40
  (( video > source_kbps )) && video=$source_kbps
  for try in 1 2 3 4; do
    for p in 1 2; do
      pass_base=$(( (p - 1) * 50 )) pass_span=50
      pass_args=(-pass $p -passlogfile "$tmp/pass")
      case $format in
        h264) codec_args=(-c:v libx264 "${pass_args[@]}" -c:a aac -movflags +faststart) ;;
        h265) codec_args=(-c:v libx265 -x265-params "log-level=error:pass=$p:stats=$tmp/x265" -tag:v hvc1 -c:a aac -movflags +faststart) ;;
        vp9) codec_args=(-c:v libvpx-vp9 -row-mt 1 -cpu-used 4 "${pass_args[@]}" -c:a libopus) ;;
      esac
      codec_args+=(-vf "$vf" -pix_fmt yuv420p -b:v "${video}k" -b:a "$((audio ? audio : 96))k" -sn)
      if (( p == 1 )); then
        ffmpeg_run "${input[@]}" "${codec_args[@]}" -an -f null /dev/null || return 1
      else
        ffmpeg_run "${input[@]}" "${codec_args[@]}" "$part" || return 1
      fi
    done
    actual=$(stat -c %s -- "$part")
    (( actual <= limit )) && return 0
    video=$((video * limit / actual * 93 / 100))
    (( video >= 20 )) || break
  done
  err="Could not fit the target size"
  return 1
}

convert_media() {
  local duration crf args fps rate cq
  duration=$(probe format=duration)
  duration_us=0
  [[ $duration =~ ^([0-9]+)\.([0-9]{6})$ ]] && duration_us=$((10#${BASH_REMATCH[1]}${BASH_REMATCH[2]}))
  if (( duration_us > 0 && start_us >= duration_us )); then
    err="Start is past the end"
    return 1
  fi
  clip_us=$duration_us
  (( end_us > 0 && (duration_us == 0 || end_us < duration_us) )) && clip_us=$end_us
  (( clip_us > 0 )) && clip_us=$((clip_us - start_us))

  input=()
  (( start_us > 0 )) && input+=(-ss "${start_us}us")
  (( end_us > 0 )) && input+=(-t "$((end_us - start_us))us")
  input+=(-i "$f")
  [[ $strip == TRUE ]] && input+=(-map_metadata -1 -map_metadata:s -1 -map_chapters -1)

  vf="pad=ceil(iw/2)*2:ceil(ih/2)*2"  # H.264/H.265 reject odd sizes
  (( height > 0 )) && vf="scale=-2:min($height\\,ih),$vf"
  [[ $size ]] && { fit_size; return; }

  case $format in
    h264) crf=(18 23 28) cq=(19 24 29)
      args=(-vf "$vf" -c:v libx264 -crf "${crf[q]}" -pix_fmt yuv420p -c:a aac -movflags +faststart) ;;
    h265) crf=(22 27 32) cq=(23 28 33)
      args=(-vf "$vf" -c:v libx265 -crf "${crf[q]}" -tag:v hvc1 -pix_fmt yuv420p -c:a aac -movflags +faststart) ;;
    av1) crf=(26 32 40)
      args=(-vf "$vf" -c:v libsvtav1 -preset 8 -crf "${crf[q]}" -pix_fmt yuv420p -c:a aac -movflags +faststart) ;;
    vp9) crf=(28 34 40)
      args=(-vf "$vf" -c:v libvpx-vp9 -crf "${crf[q]}" -b:v 0 -row-mt 1 -cpu-used 4 -pix_fmt yuv420p -c:a libopus) ;;
    gif) fps=(20 15 10)
      args=(-vf "$vf,fps=${fps[q]},split[a][b];[a]palettegen[p];[b][p]paletteuse") ;;
    rotate-left) args=(-vf "transpose=cclock,$vf" -c:v libx264 -crf 18 -pix_fmt yuv420p -c:a aac -movflags +faststart) ;;
    rotate-right) args=(-vf "transpose=clock,$vf" -c:v libx264 -crf 18 -pix_fmt yuv420p -c:a aac -movflags +faststart) ;;
    mute) args=(-map 0:V -map "0:s?" -c copy) ;;
    srt) # first track only
      [[ $(ffprobe -v error -select_streams s -show_entries stream=index -of csv=p=0 -i "$f") ]] || { err="No subtitles"; return 1; }
      args=(-map 0:s:0 -c:s srt) ;;
    copy-mp4) args=(-map 0:V -map "0:a?" -c copy -movflags +faststart) ;;
    copy-mkv) args=(-map 0:V -map "0:a?" -map "0:s?" -map "0:t?" -c copy) ;;
    mp3) rate=(256k 192k 128k); args=(-vn -c:a libmp3lame -b:a "${rate[q]}") ;;
    m4a) rate=(256k 192k 128k); args=(-vn -c:a aac -b:a "${rate[q]}" -movflags +faststart) ;;
    opus) rate=(192k 128k 80k); args=(-vn -c:a libopus -b:a "${rate[q]}") ;;
    ogg) rate=(256k 192k 128k); args=(-vn -c:a libvorbis -b:a "${rate[q]}") ;;
    flac) args=(-vn -c:a flac) ;;
    wav) args=(-vn -c:a pcm_s16le) ;;
  esac

  # Hardware encoders have size limits, so any failure falls back to the CPU
  local tail=(-c:a aac -movflags +faststart)
  [[ $format == h265 ]] && tail+=(-tag:v hvc1)
  case $hw in
    nvenc) ffmpeg_run "${input[@]}" -vf "$vf" -c:v "${codec}_nvenc" -preset p5 -rc vbr -cq "${cq[q]}" -b:v 0 \
      -pix_fmt yuv420p "${tail[@]}" "$part" && return ;;
    vaapi) ffmpeg_run -vaapi_device "$node" "${input[@]}" -vf "$vf,format=nv12,hwupload" -c:v "${codec}_vaapi" \
      -qp "${cq[q]}" "${tail[@]}" "$part" && return ;;
  esac
  ffmpeg_run "${input[@]}" "${args[@]}" "$part"
}

# The source is linked under a plain name: magick parses [], : and % in paths
convert_image() {
  local quality=(95 85 70) args=() src=$tmp/in suffix=${name##*.}
  [[ $suffix =~ ^[A-Za-z0-9]+$ && $suffix != "$name" ]] && src+=.${suffix,,}
  ln -sf -- "$f" "$src"
  if [[ $src == *.avif ]]; then
    ffmpeg_run -i "$f" -frames:v 1 "$tmp/decoded.png" || return 1
    src=$tmp/decoded.png
  fi
  if [[ $src == *.hei[cf] && $(magick -list format) != *" HEIC "* ]]; then
    local heif
    heif=$(command -v heif-dec || command -v heif-convert) || { err="$(t "Not installed"): libheif-tools"; return 1; }
    run "$heif" "$src" "$tmp/decoded.png" || return 1
    src=$tmp/decoded.png
  fi
  (( height > 0 )) && args+=(-resize "x$height>")
  # The color profile stays, or wide-gamut photos change color
  [[ $strip == TRUE ]] && args+=(+profile '!icc,*' +set comment)
  if [[ $format == avif ]]; then
    local crf=(18 26 34)
    sink=$tmp/oriented.png run magick -background none "${src}[0]" -auto-orient "${args[@]}" png:- || return 1
    # AVIF keeps transparency in a second stream
    ffmpeg_run -i "$tmp/oriented.png" -filter_complex "format=rgba,split[c][a];[c]scale=out_color_matrix=bt709:out_range=pc,format=yuv420p,setparams=colorspace=bt709:range=pc[v];[a]alphaextract,format=gray,setparams=colorspace=bt709:range=pc[m]" \
      -map "[v]" -map "[m]" -frames:v 1 -c:v libaom-av1 -still-picture 1 -cpu-used 6 -crf "${crf[q]}" "$part"
    return
  fi
  [[ $format == ico ]] && args+=(-resize '256x256>' -gravity center -extent '%[fx:max(w,h)]x%[fx:max(w,h)]' -define icon:auto-resize=256,64,48,32,16)
  [[ $format == @(jpg|pdf) ]] && args+=(-background white -alpha remove)
  [[ $format == @(jpg|webp|jxl|pdf) ]] && args+=(-quality "${quality[q]}")
  sink=$part run magick -background none "${src}[0]" -auto-orient "${args[@]}" "$format:-"
}

convert_pdf() {
  local flag=-png
  local lang
  case $format in
    txt) run pdftotext -layout "$f" "$part"; return ;;
    merge) cp -- "$f" "$part"; return ;;
    split) mkdir "$part" && run pdfseparate "$f" "$part/page-%03d.pdf"; return ;;
    compress)
      run gs -q -dSAFER -dBATCH -dNOPAUSE -sDEVICE=pdfwrite -dPDFSETTINGS=/ebook -sOutputFile="${part//%/%%}" -f "$f" || return 1
      (( $(stat -c %s -- "$part") < $(stat -Lc %s -- "$f") )) && return
      err="Already compressed"
      return 1 ;;
    ocr)
      declare -A ocr_lang=([uk]=ukr [de]=deu [es]=spa [fr]=fra [pl]=pol [nl]=nld [ca]=cat)
      lang=eng
      [[ ${ocr_lang[$locale]} ]] && tesseract --list-langs 2>/dev/null | grep -qx "${ocr_lang[$locale]}" && lang+=+${ocr_lang[$locale]}
      run ocrmypdf --skip-text -l "$lang" "$f" "$part"
      return ;;
  esac
  [[ $format == jpg ]] && flag=-jpeg
  mkdir "$part" && run pdftoppm "$flag" -r 150 "$f" "$part/page" || return 1
  local files=("$part"/*)
  (( ${#files[@]} == 1 )) || return 0
  mv -- "${files[0]}" "$tmp/page" && rmdir "$part" && mv -T -- "$tmp/page" "$part" && pick_out ".$ext"
}

convert_ebook() { run ebook-convert "$f" "$part"; }

# soffice names its own output, so use a scratch folder and a private profile
convert_office() {
  local produced filter=$ext
  [[ $ext == csv ]] && filter="csv:Text - txt - csv (StarCalc):44,34,76"  # UTF-8, commas
  rm -rf "$tmp/office"
  run soffice "-env:UserInstallation=file://$tmp/profile" --headless --convert-to "$filter" --outdir "$tmp/office" "$f" || return 1
  produced=("$tmp"/office/*."$ext")
  [[ -f ${produced[0]} ]] && cp -- "${produced[0]}" "$part"
}

# pick_out SUFFIX: set out to a free name next to the source
pick_out() {
  local n=1
  out=$base$1
  while [[ -e $out || -L $out ]]; do out="$base ($((n++)))$1"; done
}

last_out=
for f in "$@"; do
  [[ $f == /* ]] || f=$PWD/$f
  name=${f##*/}
  stem=${name%.*}
  base=${f%/*}/${stem:-$name}
  [[ $merge && $index == 0 ]] && merge_base=$base
  if [[ $format == mute ]]; then
    ext=${name##*.} ext=${ext,,}
    [[ $name == *.* && $ext == @(mp4|mov|mkv|webm) ]] || ext=mkv
  fi
  suffix=.$ext
  [[ $pages ]] && suffix=
  pick_out "$suffix"
  part="${out%/*}/.dolphin-convert-$$.$ext"
  err= clip_us=0 pass_base=0 pass_span=100
  : >"$tmp/log"
  case $kind in
    video|audio) convert_media ;;
    *) "convert_$kind" ;;
  esac
  rc=$?
  if [[ $merge ]] && (( rc == 0 )) && mv -- "$part" "$tmp/$(printf %06d "$index").pdf"; then
    done_n=$((done_n + 1))
  elif [[ ! $merge ]] && (( rc == 0 )) && mv -nT -- "$part" "$out" && [[ ! -e $part ]]; then
    done_n=$((done_n + 1))
    last_out=$out
  else
    rm -rf "$part"
    failed+=("$name: $([[ $err ]] && t "$err" || tail -n1 "$tmp/log")")
  fi
  part=
  index=$((index + 1))
done
if [[ $merge ]] && (( ${#failed[@]} )); then
  done_n=0  # no PDF with silently missing pages
elif [[ $merge ]]; then
  index=$((total - 1)) base=$merge_base
  pick_out .pdf
  part="${out%/*}/.dolphin-convert-$$.pdf"
  if run pdfunite "$tmp"/[0-9]*.pdf "$part" && mv -nT -- "$part" "$out" && [[ ! -e $part ]]; then
    last_out=$out
  else
    rm -f "$part"
    done_n=0
    failed+=("${out##*/}: $(tail -n1 "$tmp/log")")
  fi
  part=
fi
echo 100 >&3 2>/dev/null
exec 3>&-

summary="$(t Done): $done_n $(t of) $total"
if [[ $last_out ]]; then
  ( [[ $(timeout 600 notify-send -A "open=$(t "Open folder")" -i dolphin-convert -a dolphin-convert "$title" "$summary") == open ]] &&
    exec dolphin --select "$last_out" ) >/dev/null 2>&1 &
else
  notify-send -i dolphin-convert -a dolphin-convert "$title" "$summary"
fi
if (( ${#failed[@]} )); then
  kdialog --icon dolphin-convert --title "$title" --error "$(printf '%s\n' "$(t Failed):" "${failed[@]}")"
  exit 1
fi
